import numpy as np
import onnxruntime as ort
import onnx

# 1. 加载模型
model = onnx.load("gtcrn.onnx")

# 2. 自动寻找所有 Conv 节点的输出名字
conv_names = []
for node in model.graph.node:
    if node.op_type == "Conv":
        conv_names.append(node.output[0])

# 3. 强行将中间层暴露为模型输出
inferred_model = onnx.shape_inference.infer_shapes(model)
for out_info in inferred_model.graph.value_info:
    if out_info.name in conv_names:
        model.graph.output.append(out_info)

onnx.save(model, "temp_gtcrn.onnx")
sess = ort.InferenceSession("temp_gtcrn.onnx")

# 4. 构造假输入 (1, 257, 10, 2)
input_data = np.zeros((1, 257, 10, 2), dtype=np.float32)
input_data[:, :, :, 0] = 1.0 / 32.0  # 实部
input_data[:, :, :, 1] = 0.0         # 虚部

# 5. 跑模型截获输出
print("Running ONNX...")
outputs = sess.run(conv_names, {"input_spec": input_data})

# 6. 打印前 4 个 Conv 层的第一个值，用来和 C 代码对齐
for i in range(min(4, len(conv_names))):
    print(f"Python Node {i} ({conv_names[i]}): {outputs[i].flatten()[0]:.6f}")
